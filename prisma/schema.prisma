datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("USER") // USER | ADMIN
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  profile          Profile?
  wallet           Wallet?
  dailyRewardState DailyRewardState?
  subscription     UserSubscription?
  timelines        UserStoryTimeline[]
  storyProgress    UserStoryProgress[]
  episodeProgress  UserEpisodeProgress[]
  choices          UserChoice[]
  relationships    UserRelationship[]
  storyStats       UserStoryStat[]
  episodeUnlocks   EpisodeUnlock[]
  achievements     UserAchievement[]
  analyticsEvents  AnalyticsEvent[]
  paymentOrders    PaymentOrder[]
  attribution      UserAttribution?

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id              String    @id @default(cuid())
  userId          String    @unique
  displayName     String
  bio             String?
  avatarUrl       String?
  preferredLocale String    @default("id") // "id" | "en"
  level           Int       @default(1)
  exp             Int       @default(0)
  streak          Int       @default(0)
  lastActiveAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Story {
  id                 String    @id @default(cuid())
  title              String
  titleId            String?   // Indonesian localized title
  slug               String    @unique
  shortDescription   String
  shortDescriptionId String?   // Indonesian localized short pitch
  description        String
  descriptionId      String?   // Indonesian localized full synopsis
  coverImage         String
  bannerImage        String?
  author             String    @default("PLOT Studio")
  ageRating          String    @default("16+") // ALL | 13+ | 16+ | 18+
  status             String    @default("PUBLISHED") // DRAFT | PUBLISHED | COMPLETED | ARCHIVED
  featured           Boolean   @default(false)
  viewCount          Int       @default(0)
  startCount         Int       @default(0)
  completionCount    Int       @default(0)
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  genres            StoryGenre[]
  tags              StoryTag[]
  characters        Character[]
  statDefinitions   StoryStatDefinition[]
  episodes          Episode[]
  endings           Ending[]
  timelines         UserStoryTimeline[]
  userProgress      UserStoryProgress[]
  userChoices       UserChoice[]
  userRelationships UserRelationship[]
  userStoryStats    UserStoryStat[]

  @@index([status])
  @@index([featured])
  @@index([slug])
}

model Genre {
  id      String       @id @default(cuid())
  name    String       @unique
  nameId  String?
  slug    String       @unique
  icon    String?
  stories StoryGenre[]
}

model StoryGenre {
  storyId String
  genreId String
  story   Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  genre   Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([storyId, genreId])
  @@index([storyId])
  @@index([genreId])
}

model StoryTag {
  id      String @id @default(cuid())
  storyId String
  tag     String
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId])
  @@index([tag])
}

model Character {
  id                  String           @id @default(cuid())
  storyId             String
  name                String
  nameId              String?
  slug                String
  role                String           @default("SUPPORTING") // PROTAGONIST | MAIN_LOVE_INTEREST | LOVE_INTEREST | ANTAGONIST | SUPPORTING
  biography           String?
  biographyId         String?
  avatarUrl           String?
  relationshipEnabled Boolean          @default(true)
  defaultLove         Int              @default(0)
  defaultTrust        Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  story         Story            @relation(fields: [storyId], references: [id], onDelete: Cascade)
  assets        CharacterAsset[]
  relationships UserRelationship[]

  @@index([storyId])
  @@index([slug])
}

model CharacterAsset {
  id          String    @id @default(cuid())
  characterId String
  expression  String    // normal | happy | sad | angry | shocked | embarrassed | smirk | crying | determined
  imageUrl    String

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, expression])
  @@index([characterId])
}

model StoryStatDefinition {
  id           String @id @default(cuid())
  storyId      String
  key          String // e.g. REPUTATION, REVENGE
  label        String
  labelId      String?
  description  String?
  defaultValue Int    @default(50)
  minVal       Int    @default(0)
  maxVal       Int    @default(100)
  icon         String?

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, key])
  @@index([storyId])
}

model Episode {
  id           String    @id @default(cuid())
  storyId      String
  number       Int
  title        String
  titleId      String?
  synopsis     String?
  synopsisId   String?
  status       String    @default("PUBLISHED") // DRAFT | PUBLISHED | ARCHIVED
  unlockType   String    @default("FREE") // FREE | COIN_LOCKED | PREMIUM
  coinPrice    Int       @default(0)
  diamondPrice Int       @default(0)
  coverImage   String?
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  story          Story                 @relation(fields: [storyId], references: [id], onDelete: Cascade)
  nodes          StoryNode[]
  userProgress   UserEpisodeProgress[]
  episodeUnlocks EpisodeUnlock[]
  userChoices    UserChoice[]

  @@unique([storyId, number])
  @@index([storyId])
  @@index([status])
}

model StoryNode {
  id         String   @id @default(cuid())
  episodeId  String
  nodeId     String   // e.g. "node_1", "choice_1", "scene_2" (unique within episode)
  nodeIndex  Int
  type       String   // DIALOGUE | NARRATION | CHOICE | STAT_CHANGE | RELATIONSHIP_CHANGE | SCENE_CHANGE | MUSIC_CHANGE | SFX | DELAY | JUMP | END_EPISODE | ENDING
  configJson String   // Structured JSON validated by Zod (supports text & textId)
  nextNodeId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([episodeId, nodeId])
  @@index([episodeId])
  @@index([nodeIndex])
}

model Ending {
  id            String  @id @default(cuid())
  storyId       String
  slug          String  // e.g. "true-love", "independent", "revenge", "secret"
  title         String
  titleId       String?
  description   String
  descriptionId String?
  badgeTitle    String
  badgeTitleId  String?
  artworkUrl    String?
  conditionJson String? // Structured conditions required to unlock
  endingType    String  @default("TRUE_LOVE") // TRUE_LOVE | INDEPENDENT | REVENGE | SECRET

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, slug])
  @@index([storyId])
}

model UserStoryProgress {
  id                   String    @id @default(cuid())
  userId               String
  storyId              String
  currentEpisodeNumber Int       @default(1)
  lastPlayedNodeId     String?
  isCompleted          Boolean   @default(false)
  unlockedEndings      String    @default("[]") // JSON string array of ending slugs
  restartedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
  @@index([userId])
  @@index([storyId])
}

model UserEpisodeProgress {
  id          String    @id @default(cuid())
  userId      String
  episodeId   String
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  lastNodeId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@index([userId])
  @@index([episodeId])
}

model UserChoice {
  id               String   @id @default(cuid())
  userId           String
  storyId          String
  episodeId        String
  nodeId           String
  choiceOptionId   String
  choiceOptionText String
  createdAt        DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  story   Story   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([storyId])
  @@index([episodeId])
  @@index([nodeId, choiceOptionId])
}

model UserRelationship {
  id          String   @id @default(cuid())
  userId      String
  storyId     String
  characterId String
  loveValue   Int      @default(0)
  trustValue  Int      @default(0)
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  story     Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId, characterId])
  @@index([userId])
  @@index([storyId])
  @@index([characterId])
}

model UserStoryStat {
  id        String   @id @default(cuid())
  userId    String
  storyId   String
  statKey   String
  value     Int      @default(50)
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId, statKey])
  @@index([userId])
  @@index([storyId])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  coins     Int      @default(100)
  diamonds  Int      @default(20)
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id             String   @id @default(cuid())
  walletId       String
  currency       String   // COINS | DIAMONDS
  amount         Int      // Positive for credit, negative for debit
  type           String   // SIGNUP_BONUS | DAILY_REWARD | EPISODE_UNLOCK | PREMIUM_CHOICE | ADMIN_GRANT | PURCHASE | PAYMENT_PURCHASE | REFUND | MISSION_REWARD
  source         String?
  referenceId    String?
  paymentOrderId String?  @unique
  balanceAfter   Int
  description    String?
  createdAt      DateTime @default(now())

  wallet       Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  paymentOrder PaymentOrder? @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)

  @@index([walletId])
  @@index([type])
  @@index([createdAt])
}

model EpisodeUnlock {
  id           String   @id @default(cuid())
  userId       String
  episodeId    String
  coinSpent    Int      @default(0)
  diamondSpent Int      @default(0)
  unlockedAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@index([userId])
  @@index([episodeId])
}

model DailyRewardState {
  id              String    @id @default(cuid())
  userId          String    @unique
  streak          Int       @default(0)
  lastClaimedAt   DateTime?
  currentDayIndex Int       @default(1) // 1 to 7
  totalClaimed    Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id            String   @id @default(cuid())
  code          String   @unique // FIRST_CHOICE | FIRST_EPISODE | FIRST_STORY_COMPLETE | HEARTBREAKER | HOPELESS_ROMANTIC | SECRET_ENDING | COMPLETIONIST
  title         String
  titleId       String?
  description   String
  descriptionId String?
  icon          String   @default("trophy")
  coinReward    Int      @default(10)
  diamondReward Int      @default(2)
  category      String   @default("GENERAL") // GENERAL | STORY | RELATIONSHIP | SECRET
  createdAt     DateTime @default(now())

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

model CurrencyPackage {
  id           String   @id @default(cuid())
  code         String   @unique // C1 | C2 | C3 | C4 | D1 | D2 | D3 | D4
  currencyType String   // COINS | DIAMONDS
  amount       Int
  bonusAmount  Int      @default(0)
  priceIDR     Int      // 10000 | 25000 | 50000 | 100000
  label        String?  // e.g. "BEST STARTER", "POPULAR", "BEST VALUE"
  labelId      String?
  featured     Boolean  @default(false)
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders PaymentOrder[]

  @@index([currencyType])
  @@index([active])
  @@index([sortOrder])
}

model PaymentOrder {
  id              String    @id @default(cuid())
  orderId         String    @unique // e.g. "PLOT-20260817-A7F41"
  userId          String
  packageId       String
  currencyType    String    // COINS | DIAMONDS
  currencyAmount  Int
  priceIDR        Int
  paymentMethod   String    // GOPAY | OVO
  paymentNumber   String    @default("087797877931")
  status          String    @default("AWAITING_PAYMENT") // CREATED | AWAITING_PAYMENT | PROOF_SUBMITTED | UNDER_REVIEW | APPROVED | REJECTED | EXPIRED | CANCELLED
  proofImageUrl   String?
  proofUploadedAt DateTime?
  reviewedBy      String?   // Admin User ID
  reviewedAt      DateTime?
  rejectionReason String?
  adminNote       String?
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?
  updatedAt       DateTime  @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  package           CurrencyPackage    @relation(fields: [packageId], references: [id])
  auditLogs         PaymentAuditLog[]
  walletTransaction WalletTransaction?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model PaymentAuditLog {
  id             String   @id @default(cuid())
  paymentOrderId String
  action         String   // CREATED | PROOF_SUBMITTED | APPROVED | REJECTED | CANCELLED
  previousStatus String?
  newStatus      String
  performedBy    String   // user ID | admin ID | SYSTEM
  note           String?
  createdAt      DateTime @default(now())

  paymentOrder PaymentOrder @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)

  @@index([paymentOrderId])
  @@index([createdAt])
}

model Asset {
  id        String   @id @default(cuid())
  name      String
  type      String   // COVER | BANNER | BACKGROUND | CHARACTER | AVATAR | AUDIO_MUSIC | AUDIO_SFX | ENDING_ART
  url       String
  sizeBytes Int      @default(0)
  mimeType  String?
  createdAt DateTime @default(now())

  @@index([type])
}

model AnalyticsEvent {
  id             String   @id @default(cuid())
  userId         String?
  eventName      String   // story_view | story_start | episode_start | episode_complete | choice_selected | etc.
  propertiesJson String   @default("{}")
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventName])
  @@index([createdAt])
  @@index([userId])
}

model UserStoryTimeline {
  id                   String    @id @default(cuid())
  userId               String
  storyId              String
  name                 String    @default("Timeline Utama")
  slotIndex            Int       @default(0) // 0 (Free default), 1, 2 (Premium slots)
  currentEpisodeNumber Int       @default(1)
  lastPlayedNodeId     String?
  isCompleted          Boolean   @default(false)
  statsJson            String    @default("{}") // e.g. {"REPUTATION": 65, "LOVE": 70}
  relationshipsJson    String    @default("{}") // e.g. {"adrian": {"love": 60, "trust": 80}}
  flagsJson            String    @default("[]") // Array of set decision flags
  choicesJson          String    @default("{}") // Map of choiceNodeId -> optionId
  unlockedEndings      String    @default("[]") // Array of ending slugs discovered
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId, slotIndex])
  @@index([userId])
  @@index([storyId])
}

model UserSubscription {
  id         String    @id @default(cuid())
  userId     String    @unique
  tier       String    @default("PLUS") // PLUS | VIP
  status     String    @default("ACTIVE") // ACTIVE | CANCELLED | EXPIRED
  startedAt  DateTime  @default(now())
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model UserAttribution {
  id                    String    @id @default(cuid())
  userId                String    @unique
  anonymousSessionId    String?
  // First Touch (Acquisition origin)
  firstTouchSource      String?   // e.g. tiktok
  firstTouchMedium      String?   // e.g. paid | organic
  firstTouchCampaign    String?   // e.g. amm_launch
  firstTouchContent     String?   // e.g. amm_choice_contract_01
  firstTouchTerm        String?
  firstTouchLandingPath String?
  firstTouchReferrer    String?
  firstSeenAt           DateTime  @default(now())
  // Last Touch (Converting touchpoint)
  lastTouchSource       String?
  lastTouchMedium       String?
  lastTouchCampaign     String?
  lastTouchContent      String?
  lastTouchTerm         String?
  lastTouchLandingPath  String?
  lastTouchReferrer     String?
  lastSeenAt            DateTime  @default(now())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([firstTouchSource])
  @@index([firstTouchCampaign])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}



